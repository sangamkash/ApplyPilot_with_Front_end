# ApplyPilot Environment Configuration
# Copy to ~/.applypilot/.env and fill in your values.

# ---------------------------------------------------------------------------
# Auto-Apply AI Provider Configuration
# ---------------------------------------------------------------------------
# Supported providers: claude (default), gemini, openai
AUTO_APPLY_AI_PROVIDER=claude

# Claude Configuration (when AUTO_APPLY_AI_PROVIDER=claude)
# ANTHROPIC_API_KEY=your_anthropic_api_key
# CLAUDE_MODEL=sonnet

# Gemini Configuration (when AUTO_APPLY_AI_PROVIDER=gemini)
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.0-flash

# OpenAI Configuration (when AUTO_APPLY_AI_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Scoring / Tailoring LLM Provider (pick one)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=           # Gemini 2.0 Flash (recommended, free tier)
# OPENAI_API_KEY=         # OpenAI (GPT-4o-mini)
# LLM_URL=http://127.0.0.1:8080/v1  # Local LLM (llama.cpp, Ollama)
# LLM_MODEL=              # Override model name

# Auto-Apply CAPTCHA solving (optional)
# CAPSOLVER_API_KEY=      # For CAPTCHA solving during auto-apply

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass
